# Copy to .env to override defaults. `docker compose up` also works without a .env file.
# Never commit .env. The values below are for local development only.

# --- Database container (read by docker-compose.yml) ---
# Username, password and database name for the local PostgreSQL container.
# Changing these after the first start has no effect until you run `docker compose down -v`,
# which deletes the local database.
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

# --- Backend (API, worker and CLI) ---
# Connection string, using the asyncpg driver. Required when running the backend outside Compose;
# Compose builds its own from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
# One of: development, test, production. `production` turns on the HSTS header.
APP_ENV=development
# Log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API across origins. Leave empty in
# development, where the Vite dev server proxies API calls and CORS isn't involved.
CORS_ALLOWED_ORIGINS=

# --- Worker ---
# Seconds to wait before checking for new jobs when the queue is empty.
WORKER_POLL_INTERVAL_SECONDS=1
# Extra seconds a job's lease lasts beyond its own timeout, before it counts as crashed.
WORKER_LEASE_GRACE_SECONDS=30
# Seconds between checks for crashed jobs to reclaim.
WORKER_RECLAIM_INTERVAL_SECONDS=30

# --- Frontend ---
# Where the Vite dev server sends API calls. Used when running the frontend outside Compose.
API_PROXY_TARGET=http://localhost:8000

# --- Tests ---
# A separate database for backend tests, which erase its data. Created automatically if missing.
TEST_DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot_test
# Set to 1 to make database tests fail, rather than skip, when PostgreSQL is unreachable.
REQUIRE_DB_TESTS=0
